# Copia questo file in .env e personalizza. Docker Compose lo legge automaticamente.

# Porta esposta e URL pubblico (usato nei link delle email e come redirect di Google)
NOISES_PORT=8080
PUBLIC_URL=http://localhost:8080

# HTTPS (make up-https): serve se apri l'app da un altro computer, es. server su Raspberry Pi.
# Nomi/indirizzi del server separati da virgola; con HTTPS imposta anche PUBLIC_URL=https://…
HTTPS_HOSTS=localhost
HTTPS_PORT=443
# Se apri l'app con l'indirizzo IP (https://192.168.1.50) mettilo anche qui
HTTPS_DEFAULT_SNI=localhost

# Autenticazione
EMAIL_VERIFICATION=true        # false = account attivi subito, senza conferma via email
ALLOW_REGISTRATION=true        # false = nessuna nuova registrazione

# Google SSO (opzionale) — redirect URI autorizzato: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (opzionale) — senza SMTP i link vengono scritti nei log (make logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Noises <noreply@example.com>
SMTP_TLS=starttls              # starttls | tls | none

# Elaborazione
DEMUCS_DEVICE=cpu
DEMUCS_THREADS=4
RUBBERBAND_ARGS=
RENDER_JOBS=0

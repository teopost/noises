# HTTPS davanti a Noises (profilo "https" del compose).
# Il motore audio del browser (AudioWorklet) funziona solo in pagine sicure: HTTPS o localhost.
# Caddy genera da solo un certificato firmato da una sua CA locale: nessun dominio pubblico richiesto.
{
	local_certs
	# Aprendo l'app con l'indirizzo IP (https://192.168.1.50) il browser non indica il nome del
	# server: Caddy usa allora il certificato di questo nome/indirizzo.
	default_sni {$HTTPS_DEFAULT_SNI:localhost}
}

# Nomi e/o indirizzi con cui si raggiunge il server, separati da virgola
# (es. HTTPS_HOSTS="raspberrypi.local, 192.168.1.50")
{$HTTPS_HOSTS:localhost} {
	reverse_proxy noises:8080
}
